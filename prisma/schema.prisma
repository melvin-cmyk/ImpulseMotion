generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String              @id @default(cuid())
  name            String?
  email           String?             @unique
  emailVerified   DateTime?
  image           String?
  passwordHash    String?
  role            String              @default("client")
  accounts        Account[]
  sessions        Session[]
  reports         SharedReport[]
  adAccounts      UserAdAccount[]
  mcpPermissions  UserMcpPermission[]
  reportSchedules ReportSchedule[]
  alertRules      AlertRule[]
  budgets         AccountBudget[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model UserAdAccount {
  id        String   @id @default(cuid())
  userId    String
  platform  String
  accountId String
  label     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, accountId])
  @@index([userId])
}

model UserMcpPermission {
  id        String   @id @default(cuid())
  userId    String
  mcpServer String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mcpServer])
  @@index([userId])
}

model SharedReport {
  id          String   @id @default(cuid())
  userId      String
  name        String
  periodFrom  String
  periodTo    String
  creativeIds String
  metrics     String
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model DeckHistory {
  id          String   @id @default(cuid())
  clientId    String
  clientName  String
  platform    String
  period      String
  startDate   DateTime
  endDate     DateTime
  slidesJson  String   @db.Text
  metricsJson String   @db.Text
  createdAt   DateTime @default(now())
  userId      String?

  @@index([clientId, createdAt])
}

model DeckDraft {
  id              String   @id @default(cuid())
  userId          String
  clientId        String
  periodKey       String
  droppedBlocks   String   @db.Text
  slideOverrides  String   @db.Text
  customSlides    String   @db.Text
  slideNotes      String   @db.Text
  blockStyles     String   @db.Text
  slideElements   String   @db.Text
  textStyles      String   @db.Text
  aiDynamicSlides String   @db.Text
  masterElements  String?  @db.Text
  themeId         String?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@unique([userId, clientId, periodKey])
  @@index([userId, updatedAt])
}

model ReportSchedule {
  id           String    @id @default(cuid())
  userId       String
  clientId     String
  clientLabel  String?
  platform     String    @default("meta")
  frequency    String    @default("monthly")
  recipients   String    @db.Text
  enabled      Boolean   @default(true)
  lastRunAt    DateTime?
  lastRunError String?   @db.Text
  nextRunAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([nextRunAt])
}

model AlertRule {
  id              String       @id @default(cuid())
  userId          String
  clientId        String?
  platform        String       @default("meta")
  metric          String
  condition       String
  threshold       Float
  window          String       @default("7d")
  enabled         Boolean      @default(true)
  lastTriggeredAt DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  events          AlertEvent[]

  @@index([userId])
}

model AccountBudget {
  id            String   @id @default(cuid())
  userId        String
  accountId     String
  platform      String   @default("meta")
  monthlyTarget Float
  currency      String   @default("EUR")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, accountId])
  @@index([userId])
}

model AlertEvent {
  id                          String    @id @default(cuid())
  ruleId                      String
  userId                      String
  clientId                    String
  metric                      String
  value                       Float
  threshold                   Float
  message                     String    @db.Text
  acknowledged                Boolean   @default(false)
  triggeredAt                 DateTime  @default(now())
  recommendations             String?   @db.Text
  recommendationsGeneratedAt  DateTime?
  rule                        AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, triggeredAt])
  @@index([userId, triggeredAt])
}
