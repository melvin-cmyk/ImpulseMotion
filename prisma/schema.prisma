generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String              @id @default(cuid())
  name                 String?
  email                String?             @unique
  emailVerified        DateTime?
  image                String?
  passwordHash         String?
  role                 String              @default("client")
  accounts             Account[]
  sessions             Session[]
  reports              SharedReport[]
  adAccounts           UserAdAccount[]
  mcpPermissions       UserMcpPermission[]
  reportSchedules      ReportSchedule[]
  alertRules           AlertRule[]
  budgets              AccountBudget[]
  dashboards           Dashboard[]
  dashboardMemberships DashboardMember[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}

model UserAdAccount {
  id        String   @id @default(cuid())
  userId    String
  platform  String
  accountId String
  label     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, accountId])
  @@index([userId])
}

model UserMcpPermission {
  id        String   @id @default(cuid())
  userId    String
  mcpServer String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mcpServer])
  @@index([userId])
}

model SharedReport {
  id          String   @id @default(cuid())
  userId      String
  name        String
  periodFrom  String
  periodTo    String
  creativeIds String
  metrics     String
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model DeckHistory {
  id          String   @id @default(cuid())
  clientId    String
  clientName  String
  platform    String
  period      String
  startDate   DateTime
  endDate     DateTime
  slidesJson  String   @db.Text
  metricsJson String   @db.Text
  createdAt   DateTime @default(now())
  userId      String?

  @@index([clientId, createdAt])
}

model DeckDraft {
  id              String   @id @default(cuid())
  userId          String
  clientId        String
  periodKey       String
  droppedBlocks   String   @db.Text
  slideOverrides  String   @db.Text
  customSlides    String   @db.Text
  slideNotes      String   @db.Text
  blockStyles     String   @db.Text
  slideElements   String   @db.Text
  textStyles      String   @db.Text
  aiDynamicSlides String   @db.Text
  masterElements  String?  @db.Text
  themeId         String?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@unique([userId, clientId, periodKey])
  @@index([userId, updatedAt])
}

model ReportSchedule {
  id           String    @id @default(cuid())
  userId       String
  clientId     String
  clientLabel  String?
  platform     String    @default("meta")
  frequency    String    @default("monthly")
  recipients   String    @db.Text
  enabled      Boolean   @default(true)
  lastRunAt    DateTime?
  lastRunError String?   @db.Text
  nextRunAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([nextRunAt])
}

model AlertRule {
  id              String       @id @default(cuid())
  userId          String
  clientId        String?
  platform        String       @default("meta")
  metric          String
  condition       String
  threshold       Float
  window          String       @default("7d")
  enabled         Boolean      @default(true)
  lastTriggeredAt DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  events          AlertEvent[]

  @@index([userId])
}

model AccountBudget {
  id            String   @id @default(cuid())
  userId        String
  accountId     String
  platform      String   @default("meta")
  monthlyTarget Float
  currency      String   @default("EUR")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, accountId])
  @@index([userId])
}

model AlertEvent {
  id                         String    @id @default(cuid())
  ruleId                     String
  userId                     String
  clientId                   String
  metric                     String
  value                      Float
  threshold                  Float
  message                    String    @db.Text
  acknowledged               Boolean   @default(false)
  triggeredAt                DateTime  @default(now())
  recommendations            String?   @db.Text
  recommendationsGeneratedAt DateTime?
  rule                       AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, triggeredAt])
  @@index([userId, triggeredAt])
}

// Per-ad-account settings shared by all users (AOV fallback for accounts that
// don't track purchase value, display currency).
model AccountSetting {
  id        String   @id @default(cuid())
  platform  String   @default("meta")
  accountId String
  aov       Float?
  currency  String   @default("EUR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platform, accountId])
}

// Server-side KPI cache (insights snapshots) — avoids refetching Meta/Google
// on every render. Rows are upserted by key and expire via expiresAt.
model KpiCache {
  id        String   @id @default(cuid())
  key       String   @unique
  payload   String   @db.Text
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// ── Client steering dashboards (Lot 3) ───────────────────────────────────────

model Dashboard {
  id               String            @id @default(cuid())
  userId           String
  name             String            @default("Pilotage")
  metaAccountId    String?
  googleCustomerId String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  widgets          DashboardWidget[]
  threads          AssistantThread[]
  members          DashboardMember[]
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Extra client logins attached to a dashboard (beyond its owner userId).
model DashboardMember {
  id          String    @id @default(cuid())
  dashboardId String
  userId      String
  createdAt   DateTime  @default(now())
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dashboardId, userId])
  @@index([userId])
}

model DashboardWidget {
  id          String    @id @default(cuid())
  dashboardId String
  type        String
  title       String?
  position    Int       @default(0)
  width       String    @default("half")
  config      String    @default("{}") @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([dashboardId, position])
}

// Persisted consultant⇄AI conversation per dashboard (Lot 4)
model AssistantThread {
  id          String    @id @default(cuid())
  dashboardId String
  userId      String
  messages    String    @default("[]") @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([dashboardId, updatedAt])
}
