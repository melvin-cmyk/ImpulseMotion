generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String              @id @default(cuid())
  name                 String?
  email                String?             @unique
  emailVerified        DateTime?
  image                String?
  passwordHash         String?
  role                 String              @default("client")
  accounts             Account[]
  sessions             Session[]
  adAccounts           UserAdAccount[]
  mcpPermissions       UserMcpPermission[]
  alertRules           AlertRule[]
  budgets              AccountBudget[]
  dashboards           Dashboard[]
  dashboardMemberships DashboardMember[]
  clientReports        ClientReport[]
  botAccesses          ClientBotAccess[]
  botConversations     BotConversation[]
  consoleConversations ConsoleConversation[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}

model UserAdAccount {
  id        String   @id @default(cuid())
  userId    String
  platform  String
  accountId String
  label     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, accountId])
  @@index([userId])
}

model UserMcpPermission {
  id        String   @id @default(cuid())
  userId    String
  mcpServer String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mcpServer])
  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AlertRule {
  id              String       @id @default(cuid())
  userId          String
  clientId        String?
  platform        String       @default("meta")
  metric          String
  condition       String
  threshold       Float
  window          String       @default("7d")
  enabled         Boolean      @default(true)
  /// Where to send a triggered event: {"slackChannel"?: "#…"|"C…", "emails"?: string[]}. "{}" = in-app only.
  notifyJson      String       @default("{}") @db.Text
  /// Entity level evaluated: account | campaign | adset | ad (one event per matching entity below account).
  level           String       @default("account")
  /// {"nameContains"?: string, "minSpend"?: number} — narrows the entities considered.
  filterJson      String       @default("{}") @db.Text
  /// "rule" = deterministic metric/condition/threshold; "ai" = `prompt` judged daily by the AI on a data snapshot.
  mode            String       @default("rule")
  /// The consultant's own words (kept for both modes; the condition itself for mode "ai").
  prompt          String?      @db.Text
  /// Short human name shown in lists and notifications.
  label           String?
  lastTriggeredAt DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  events          AlertEvent[]

  @@index([userId])
}

model AccountBudget {
  id            String   @id @default(cuid())
  userId        String
  accountId     String
  platform      String   @default("meta")
  monthlyTarget Float
  currency      String   @default("EUR")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, accountId])
  @@index([userId])
}

model AlertEvent {
  id                         String    @id @default(cuid())
  ruleId                     String
  userId                     String
  clientId                   String
  metric                     String
  value                      Float
  threshold                  Float
  message                    String    @db.Text
  acknowledged               Boolean   @default(false)
  triggeredAt                DateTime  @default(now())
  recommendations            String?   @db.Text
  recommendationsGeneratedAt DateTime?
  /// Set once the n8n notification webhook accepted the event (idempotence across cron replays).
  notifiedAt                 DateTime?
  notifyError                String?   @db.Text
  /// Entity that triggered a below-account rule (campaign / adset / ad); null for account-level events.
  entityLevel                String?
  entityId                   String?
  entityName                 String?
  rule                       AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, triggeredAt])
  @@index([userId, triggeredAt])
}

// Per-ad-account settings shared by all users (AOV fallback for accounts that
// don't track purchase value, display currency).
model AccountSetting {
  id              String   @id @default(cuid())
  platform        String   @default("meta")
  accountId       String
  aov             Float?
  /// ISO 4217 — null = unknown (never assume EUR); refreshed from the Meta account profile
  currency        String?
  /// IANA timezone of the ad account (e.g. Europe/Paris), from the Meta profile
  timezone        String?
  /// purchase | lead | complete_registration | custom:<action_type>
  conversionEvent String?  @default("purchase")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([platform, accountId])
}

// Server-side KPI cache (insights snapshots) — avoids refetching Meta/Google
// on every render. Rows are upserted by key and expire via expiresAt.
model KpiCache {
  id        String   @id @default(cuid())
  key       String   @unique
  payload   String   @db.Text
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// ── Client steering dashboards (Lot 3) ───────────────────────────────────────

model Dashboard {
  id               String            @id @default(cuid())
  userId           String
  name             String            @default("Pilotage")
  metaAccountId    String?
  googleCustomerId String?
  // Opt-in AI reporting per client: null = off, "weekly" | "monthly"
  reportFrequency  String?
  // Monthly media budget of the client (pacing). Takes precedence over AccountBudget.
  monthlyBudget    Float?
  budgetCurrency   String?
  // HQ (agency memory): projects/{hqSlug}/ folder of this client. Set by staff or
  // resolved once by the lookup; the brief is cached here so a report costs one
  // HQ session per client per TTL, not one per generation.
  hqSlug           String?
  hqContextMd      String?           @db.Text
  hqContextAt      DateTime?
  // Legacy (first version of the automatic alerting, per dashboard): read once
  // when an AlertClient is created, to carry the channel and settings over.
  slackChannel     String?
  slackChannelId   String?
  autoAlerts       Boolean           @default(true)
  autoAlertConfig  String            @default("{}") @db.Text
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  widgets          DashboardWidget[]
  pages            DashboardPage[]
  threads          AssistantThread[]
  members          DashboardMember[]
  reports          ClientReport[]
  sources          DashboardSource[]
  bot              ClientBot?
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A client of the automatic alerting (lib/auto-alerts/clients.ts): every ad
/// account the agency can read belongs to one, with or without a dashboard.
model AlertClient {
  id              String         @id @default(cuid())
  /// "c:<cockpit client key>" when the accounts belong to a client of the
  /// budget sheet, else the first account ("meta:<id>" | "google:<id>").
  key             String         @unique
  name            String
  /// [{"platform":"meta"|"google","accountId":"…","name":"…","currency":"EUR"}]
  accountsJson    String         @default("[]") @db.Text
  /// Oldest dashboard on one of the accounts, when there is one (link of the message).
  dashboardId     String?
  /// Internal Slack channel ("#c_client" or a channel id). No channel =
  /// incidents are tracked in-app only.
  slackChannel    String?
  /// Slack id of that channel (C… / G…) once resolved — what the bot posts to.
  slackChannelId  String?
  autoAlerts      Boolean        @default(true)
  /// {"topics": {"billing": true, …}, "frequency": "1x"|"2x"|"4x", "weekdaysOnly": bool} — see lib/auto-alerts/config.ts
  autoAlertConfig String         @default("{}") @db.Text
  /// No account spent anything over the last ten days at the last scan.
  dormant         Boolean        @default(false)
  /// None of its accounts is readable any more; kept for its history.
  gone            Boolean        @default(false)
  lastScanAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  incidents       AutoIncident[]
}

/// A problem found by the automatic scan, followed over time so the Slack
/// channel only hears about changes (new, worse, reminder, resolved).
model AutoIncident {
  id             String    @id @default(cuid())
  /// null only on rows of the first version, until they are attached to their client.
  clientId       String?
  /// Legacy: the dashboard the first version hung incidents on.
  dashboardId    String?
  /// Stable within a client: "meta:spend_stopped@<accountId>", "meta:ad_stopped:<adId>@<accountId>"…
  key            String
  /// Group of checks that produced it, per account ("meta:days@<accountId>", "google:days@<accountId>"…)
  scope          String
  platform       String
  kind           String
  severity       String // critical | warning
  status         String    @default("open") // open | resolved
  title          String
  detail         String    @db.Text
  entityLevel    String?
  entityId       String?
  entityName     String?
  /// Consecutive runs without seeing it; closed at 2.
  missCount      Int       @default(0)
  remindCount    Int       @default(0)
  firstSeenAt    DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  resolvedAt     DateTime?
  /// First delivery to Slack; null = never delivered.
  notifiedAt     DateTime?
  lastNotifiedAt DateTime?
  notifyError    String?
  client         AlertClient? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, key])
  @@index([clientId, status])
}

// Additional data sources attached to a client (HubSpot today; Shopify / CSV later).
// Meta / Google stay on the Dashboard columns (metaAccountId / googleCustomerId).
model DashboardSource {
  id          String    @id @default(cuid())
  dashboardId String
  /// "hubspot" today; "shopify" | "csv" … later
  kind        String
  /// stable id at the provider (HubSpot portal id)
  externalId  String
  label       String?
  /// JSON, provider-specific, non-secret (e.g. { pipelineIds: [], qualifiedStages: [], currency })
  config      String    @default("{}") @db.Text
  /// AES-256-GCM (lib/secrets.ts) — never returned to the client
  secretEnc   String?   @db.Text
  status      String    @default("active") // active | error | disabled
  lastSyncAt  DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@unique([dashboardId, kind, externalId])
  @@index([dashboardId])
}

// Extra client logins attached to a dashboard (beyond its owner userId).
model DashboardMember {
  id          String    @id @default(cuid())
  dashboardId String
  userId      String
  createdAt   DateTime  @default(now())
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dashboardId, userId])
  @@index([userId])
}

/// A tab inside a dashboard (« Meta », « Google »…). Widgets with pageId = null
/// belong to the first page, so a dashboard without any page row keeps working
/// exactly as before (single implicit page).
model DashboardPage {
  id          String            @id @default(cuid())
  dashboardId String
  name        String
  position    Int               @default(0)
  /// What the consultant asked for when the AI composed the page — replayed when editing it.
  intent      String?           @db.Text
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  dashboard   Dashboard         @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  widgets     DashboardWidget[]

  @@index([dashboardId, position])
}

model DashboardWidget {
  id          String    @id @default(cuid())
  dashboardId String
  /// null = first page of the dashboard.
  pageId      String?
  type        String
  title       String?
  position    Int       @default(0)
  width       String    @default("half")
  config      String    @default("{}") @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  page        DashboardPage? @relation(fields: [pageId], references: [id], onDelete: SetNull)

  @@index([dashboardId, position])
  @@index([pageId, position])
}

// Persisted consultant⇄AI conversation per dashboard (Lot 4)
model AssistantThread {
  id          String    @id @default(cuid())
  dashboardId String
  userId      String
  messages    String    @default("[]") @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([dashboardId, updatedAt])
}

// ── AI client reports ────────────────────────────────────────────────────────
// One row per generated report. dataJson is the frozen data snapshot the AI
// wrote from (also what the chat reads), contentMd the rendered report,
// nextStepsJson the action list, chatJson the persisted Q&A thread.
model ClientReport {
  id            String    @id @default(cuid())
  dashboardId   String
  userId        String?
  title         String
  periodSince   String
  periodUntil   String
  compareSince  String?
  compareUntil  String?
  status        String    @default("generating") // generating | ready | failed
  trigger       String    @default("manual") // manual | cron
  dataJson      String    @default("{}") @db.Text
  contentMd     String    @default("") @db.Text
  summary       String?   @db.Text
  nextStepsJson String    @default("[]") @db.Text
  chatJson      String    @default("[]") @db.Text
  error         String?   @db.Text
  /// Consultant's free-text brief for the AI ("analyse surtout…"); null for cron runs. Replayed on regenerate.
  instructions  String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  dashboard     Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([dashboardId, createdAt])
  @@index([status, createdAt])
}

/// Private AI assistant offered to a client (one per Dashboard = one per client brand).
/// Replicable: enable it, write the business context, pick the sources, grant emails.
model ClientBot {
  id              String            @id @default(cuid())
  dashboardId     String            @unique
  enabled         Boolean           @default(false)
  name            String            @default("Assistant")
  /// slug used as `client_key` in the client-data warehouse (e.g. "lpev")
  clientKey       String            @unique
  /// Admin-written business context injected into the system prompt
  businessContext String            @default("") @db.Text
  /// JSON { meta: boolean, google: boolean, ga4PropertyId?: string, data: boolean }
  sourcesJson     String            @default("{}") @db.Text
  /// sha256 of the bearer token n8n uses on POST /api/ingest/* — never stored in clear
  ingestTokenHash String?
  lastIngestAt    DateTime?
  lastIngestRows  Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  dashboard       Dashboard         @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  accesses        ClientBotAccess[]
  conversations   BotConversation[]
}

/// Who may talk to a bot. Granted by an admin, by email (user auto-created as "client" if unknown).
model ClientBotAccess {
  id          String    @id @default(cuid())
  botId       String
  userId      String
  grantedById String?
  createdAt   DateTime  @default(now())
  bot         ClientBot @relation(fields: [botId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([botId, userId])
  @@index([userId])
}

model BotConversation {
  id           String    @id @default(cuid())
  botId        String
  userId       String
  title        String?
  /// JSON [{ role: "user"|"assistant", content: string, at: ISO }]
  messagesJson String    @default("[]") @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  bot          ClientBot @relation(fields: [botId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([botId, userId, updatedAt])
}

/// Conversations of the staff AI console (/ai). Private to their owner: every
/// read and write is filtered by userId, nothing is kept in the browser.
/// `id` is the conversation uuid that also names the relay session and the
/// sandbox workspace (console:<userId>:<id>).
model ConsoleConversation {
  id           String   @id
  userId       String
  title        String
  /// JSON [{ id, role, content, images?, files?, toolCalls?, toolResults?, usage? }] — no image pixels
  messagesJson String   @default("[]") @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

/// Billing ledger of the AI run on Amazon Bedrock (today: the private client
/// bots). One row per answered message. Deliberately NO foreign keys: names
/// are snapshotted so the history survives a deleted dashboard, bot or login.
model AiUsage {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  /// "bedrock"
  provider         String
  model            String
  /// "client_bot"
  feature          String
  dashboardId      String?
  /// Dashboard name at the time — the billed client.
  clientName       String
  botId            String?
  clientKey        String?
  userId           String?
  userEmail        String?
  /// "client" is billable; "admin" / "consultant" are staff tests.
  userRole         String
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  /// List-price cost reported by the model runtime (USD).
  costUsd          Float    @default(0)
  turns            Int      @default(0)
  durationMs       Int      @default(0)

  @@index([createdAt])
  @@index([dashboardId, createdAt])
}

// ── Global Cockpit ───────────────────────────────────────────────────────────
// Agency-wide weekly view (staff). Clients come from the budget sheet; their
// ad accounts are matched by name, then corrected by an admin.

/// Admin overrides of a client of the budget sheet (key = brand token of the sheet).
model CockpitClient {
  id        String   @id @default(cuid())
  key       String   @unique
  /// display name override (null = name of the sheet)
  name      String?
  /// cpa | roas | brand — null = deduced from the sheet targets, then from the data
  kpiMode   String?
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One ad account attached to a cockpit client.
model CockpitAccount {
  id        String   @id @default(cuid())
  clientKey String
  /// meta | google
  platform  String
  accountId String
  name      String
  currency  String?
  /// short label shown when a client has several accounts on a platform
  label     String?
  /// cpa | roas | brand — null = the client's model
  mode      String?
  /// auto (matched by name) | manual (set by an admin, never overwritten)
  source    String   @default("auto")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platform, accountId])
  @@index([clientKey])
}

/// Result of one build (twice a day): the page reads the latest one, the
/// older ones are the memory that shows how each client evolved.
model CockpitSnapshot {
  id         String   @id @default(cuid())
  /// Monday of the week read (YYYY-MM-DD)
  weekStart  String
  /// full | partial (time budget hit, some accounts reused from the previous build)
  status     String   @default("full")
  clients    Int      @default(0)
  dataJson   String   @db.Text
  durationMs Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// Follow-up of a client by the team (what the site calls « action »).
model CockpitAction {
  id        String   @id @default(cuid())
  clientKey String   @unique
  /// todo | doing | done | "" (none)
  state     String   @default("")
  owner     String?
  /// YYYY-MM-DD
  due       String?
  note      String?  @db.Text
  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}
